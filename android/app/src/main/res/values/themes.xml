<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mune" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mune_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/mune_pink</item>
    </style>

    <style name="Theme.Mune.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mune_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Mune</item>
    </style>
</resources>
