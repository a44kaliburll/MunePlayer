<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zoon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zoon_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/zoon_pink</item>
    </style>

    <style name="Theme.Zoon.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zoon_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Zoon</item>
    </style>
</resources>
